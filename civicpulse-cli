    print(f"payload = json.dumps({json.dumps(sample_json)}).encode()")
    print(f"req = urllib.request.Request('{args.url}/ingest', data=payload, headers={{'Content-Type': 'application/json'}})")
    print("urllib.request.urlopen(req)\n")

def cmd_inject(args):
    payload = {
        "node": args.node,
        "type": args.type,
        "durationSec": args.duration
    }
    result = api_post("/sim/inject", payload, args.url, args.api_key)
    print(f"\n{GREEN}✓ Anomaly Injected Successfully:{RESET}")
    print(f"  Target Node:  {BOLD}{args.node}{RESET}")
    print(f"  Signal Type:  {YELLOW}{args.type}{RESET}")
    print(f"  Duration:     {args.duration} seconds\n")

def cmd_sms(args):
    payload = {
        "phoneNumber": args.phone,
        "message": args.message or "[Aegis Manual Alert] Critical threshold alert dispatched via CLI.",
        "node": "CLI-Trigger",
        "metric": "vibrationRms"
    }
    result = api_post("/alerts/sms/send", payload, args.url, args.api_key)
    print(f"\n{GREEN}✓ Emergency Cellular SMS Dispatched:{RESET}")
    print(f"  Recipient:   {BOLD}{result.get('recipient')}{RESET}")
    print(f"  Status:      {GREEN}{result.get('deliveryStatus')}{RESET}")
    print(f"  Network:     {result.get('network')}")
    print(f"  Message:     {result.get('message')}\n")

def cmd_interactive(args):
    print(f"\n{BOLD}{CYAN}CivicPulse Interactive CLI Shell [v1.0.0]{RESET}")
    print(f"Connected to: {args.url}")
    print(f"Type {BOLD}'help'{RESET} for available commands or {BOLD}'exit'{RESET} to quit.\n")
    while True:
        try:
            line = input(f"{BOLD}civicpulse> {RESET}").strip()
            if not line:
                continue
            if line in ("exit", "quit", "q"):
                print("Goodbye!")
                break
            parts = line.split()
            cmd = parts[0].lower()
            if cmd == "help":
                print("\nAvailable commands:")
                print("  status            - Display real-time telemetry grid of all nodes")
                print("  alerts            - View threshold-crossing maintenance alerts")
                print("  inspect <node>    - Generate diagnostic report for a specific node")
                print("  spectrum          - Scan RF spectrum & detect frequency overlaps")
                print("  hex <node>        - Open raw hex telemetry frame inspector")
                print("  iot               - Show IoT device connection endpoints & snippets")
                print("  health            - Check server health status")
                print("  inject <n> <t> <s>- Inject anomaly (<node> <type> <seconds>)")
                print("  exit              - Exit interactive mode\n")
            elif cmd == "status":
                cmd_status(args)
            elif cmd == "health":
                cmd_health(args)
            elif cmd == "spectrum" or cmd == "overlap":
                cmd_spectrum(args)
            elif cmd == "iot":
                cmd_iot(args)
            elif cmd == "hex":
                if len(parts) < 2:
                    print(f"{RED}Usage: hex <nodeLabel>{RESET}")
                else:
                    args.node = parts[1]
                    cmd_hex(args)
            elif cmd == "alerts":
                args.limit = 10
                cmd_alerts(args)
            elif cmd == "inspect":
                if len(parts) < 2:
                    print(f"{RED}Usage: inspect <nodeLabel>{RESET}")
                else:
                    args.node = parts[1]
                    cmd_inspect(args)
            elif cmd == "inject":
                if len(parts) < 4:
                    print(f"{RED}Usage: inject <node> <type> <durationSec>{RESET}")
                else:
                    args.node = parts[1]
                    args.type = parts[2]
                    try:
                        args.duration = int(parts[3])
                        cmd_inject(args)
                    except ValueError:
                        print(f"{RED}Duration must be an integer number of seconds.{RESET}")
            else:
                print(f"{YELLOW}Unknown command '{cmd}'. Type 'help' for options.{RESET}")
        except (KeyboardInterrupt, EOFError):
            print("\nExiting.")
            break

def main():
    parser = argparse.ArgumentParser(description="CivicPulse CLI - Telemetry, RF Spectrum & IoT Management")
    parser.add_argument("--url", default=DEFAULT_URL, help=f"Base URL of CivicPulse instance (default: {DEFAULT_URL})")
    parser.add_argument("--api-key", default=None, help="Optional CivicPulse API Key header")
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("health", help="Check server health status")
    subparsers.add_parser("status", help="List all reporting nodes and real-time telemetry")
    subparsers.add_parser("spectrum", help="Scan RF spectrum & detect frequency overlaps")
    iot_p = subparsers.add_parser("iot", help="Show IoT device connection endpoints & code templates")

    sms_p = subparsers.add_parser("sms", help="Dispatch an emergency cellular SMS alert")
    sms_p.add_argument("phone", help="Recipient phone number (e.g. +15550192834)")
    sms_p.add_argument("message", nargs="?", default=None, help="Optional SMS alert message body")

    hex_p = subparsers.add_parser("hex", help="Open raw hex telemetry frame inspector for a node")
    hex_p.add_argument("node", help="Node label (e.g. Bridge-A or Streetlight-...)")

    alerts_p = subparsers.add_parser("alerts", help="Display recent maintenance alerts")
    alerts_p.add_argument("--limit", type=int, default=15, help="Maximum alerts to display")

    inspect_p = subparsers.add_parser("inspect", help="Display human-friendly diagnostic report for a node")
    inspect_p.add_argument("node", help="Node label (e.g. Bridge-A or Streetlight-...)")

    inject_p = subparsers.add_parser("inject", help="Inject a simulated anomaly into a node")
    inject_p.add_argument("node", help="Target node label")
    inject_p.add_argument("type", choices=["VIBRATION_SPIKE", "TEMP_DROP", "SENSOR_DRIFT", "DROPOUT"], help="Anomaly signal type")
    inject_p.add_argument("duration", type=int, default=15, nargs="?", help="Duration in seconds (default: 15)")

    subparsers.add_parser("shell", help="Enter interactive command-line shell")

    args = parser.parse_args()
    if args.command == "health":
        cmd_health(args)
    elif args.command == "status":
        cmd_status(args)
    elif args.command == "alerts":
        cmd_alerts(args)
    elif args.command == "inspect":
        cmd_inspect(args)
    elif args.command == "spectrum":
        cmd_spectrum(args)
    elif args.command == "hex":
        cmd_hex(args)
    elif args.command == "iot":
        cmd_iot(args)
    elif args.command == "sms":
        cmd_sms(args)
    elif args.command == "inject":
        cmd_inject(args)
    elif args.command == "shell":
        cmd_interactive(args)
    else:
        cmd_interactive(args)

if __name__ == "__main__":
    main()

    print(f"\n{BOLD}{CYAN}=== IoT Device Direct Ingestion Hub ==={RESET}")
    print(f"HTTP Ingestion URL: {BOLD}{args.url}/ingest{RESET}")
    print(f"Format: JSON (max 8KB)\n")

    sample_json = {
        "nodeType": "streetlight",
        "mac": "B8:27:EB:44:55:66",
        "vibrationRms": 0.08,
        "tempC": 22.4,
        "rfPowerDb": -58.2
    }
    print(f"{BOLD}Sample cURL Command:{RESET}")
    print(f"curl -X POST {args.url}/ingest \\")
    print("  -H 'Content-Type: application/json' \\")
    print(f"  -d '{json.dumps(sample_json)}'\n")

    print(f"{BOLD}Sample Python Sender:{RESET}")

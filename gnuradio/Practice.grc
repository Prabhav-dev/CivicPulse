- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport requests\n\
      import time\n\nclass civicpulse_http_sink(gr.sync_block):\n    \"\"\"\n    CivicPulse\
      \ HTTP Telemetry Sink\n    Calculates average power (dB) and posts JSON to CivicPulse.\n\
      \    \"\"\"\n    def __init__(self, url=\"http://127.0.0.1:7070/ingest\", mac=\"\
      AA:BB:CC:DD:EE:FF\", node_type=\"utilityline\"):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='CivicPulse HTTP Sink',\n            in_sig=[np.float32],\
      \  # Accepts float stream from your filters/moving average\n            out_sig=None\
      \           # Sink block (no output stream)\n        )\n        if \"[\" in url\
      \ and \"](\" in url:\n            url = url.split(\"](\")[1].rstrip(\")\")\n\
      \        self.url = url.strip().strip(\"'\\\"\")\n        self.mac = mac.strip().strip(\"'\\\"\")\n\
      \        self.node_type = node_type.strip().strip(\"'\\\"\")\n        self.last_send_time\
      \ = 0.0\n\n    def work(self, input_items, output_items):\n        in0 = input_items[0]\n\
      \        current_time = time.time()\n        \n        # Send telemetry once\
      \ every 1.0 second to avoid flooding the backend\n        if len(in0) > 0 and\
      \ (current_time - self.last_send_time) >= 1.0:\n            # Calculate average\
      \ power in relative dB\n            power_rms = float(np.mean(in0**2))\n   \
      \         power_db = float(10 * np.log10(power_rms + 1e-12))\n\n          \
      \  payload = {\n                \"nodeType\": self.node_type,\n           \
      \     \"mac\": self.mac,\n                \"rfPowerDb\": round(power_db, 2),\n\
      \                \"ts\": int(current_time * 1000)\n            }\n         \
      \   \n            headers = {\"Content-Type\": \"application/json\"}\n     \
      \       \n            try:\n                # Non-blocking HTTP POST request\
      \ to CivicPulse\n                resp = requests.post(self.url, json=payload,\
      \ headers=headers, timeout=0.8)\n                print(f\"[CivicPulse Sink]\
      \ Ingested RF Power: {round(power_db, 2)} dB -> HTTP {resp.status_code}\")\n\
      \            except Exception as e:\n                print(f\"[CivicPulse Sink\
      \ Warning] Could not post to {self.url}: {e}\")\n                \n        \
      \    self.last_send_time = current_time\n\n        return len(in0)"
    affinity: ''
    alias: ''
    comment: ''
    mac: '''AA:BB:CC:DD:EE:FF'''
    maxoutbuf: '0'
    minoutbuf: '0'
    node_type: '''utilityline'''
    url: '''http://127.0.0.1:7070/ingest'''
  states:
    _io_cache: ('CivicPulse HTTP Sink', 'civicpulse_http_sink', [('url', "'http://127.0.0.1:7070/ingest'"),
      ('mac', "'00:11:22:33:44:55'"), ('node_type', "'utilityline'")], [('0', 'float',
      1)], [], '\n    CivicPulse HTTP Telemetry Sink\n    Calculates average power
      (dB) and posts JSON to CivicPulse.\n    ', ['mac', 'node_type', 'url'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 524.0]
    rotation: 0
    state: enabled
